<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility: the module app must reach the target app's ContentProvider
         and vice versa, otherwise MIUI/AOSP AppsFilter blocks cross-app calls. -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="org.lsposed.manager" />
        <provider android:authorities="com.openai.chatgpt.observations" />
    </queries>

    <application
        android:name=".DshApplication"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dsh">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".api.ApiService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".api.ChatGptPlanLoginWaitService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name=".api.ChatGptPlanWebLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider
            android:name=".ObservationProvider"
            android:authorities="com.gpt.hook.observations"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
